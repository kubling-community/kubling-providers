# Create an organization Admin API key at:
# https://platform.openai.com/settings/organization/admin-keys
OPENAI_ADMIN_KEY=sk-admin-replace-me

# Unix timestamp for the beginning of the usage and costs window.
# GNU/Linux example: date -d '30 days ago' +%s
# macOS example: date -v-30d +%s
OPENAI_USAGE_START_TIME=replace-with-unix-seconds

# Optional provider and API settings.
OPENAI_USAGE_BUCKET_WIDTH=1d
OPENAI_INCLUDE_ARCHIVED_PROJECTS=true
KUBLING_OPENAPI_PROVIDER_PORT=50055
